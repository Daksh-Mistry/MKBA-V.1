[Unit]
Description=Robo Pi API and discovery (edit user and paths before installing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Robo2.0/PI
ExecStart=/bin/bash /home/pi/Robo2.0/PI/start_robo.sh
Restart=on-failure
RestartSec=3
KillMode=control-group
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
