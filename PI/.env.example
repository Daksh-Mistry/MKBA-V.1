# OPTIONAL: the normal Pi server runs without a .env file or token.
# Every mapped sensor input is read automatically. Set pin numbers in config.py.
PI_HOST=0.0.0.0
PI_PORT=8000
# Leave 0 for normal operation, including a bare Pi or partial hardware.
# 1 is only a computer simulation used by developer tests.
PI_SIMULATION=0
# ALSA device used by aplay; list devices using aplay -L.
PI_SPEECH_DEVICE=default
# Each component initializes independently. Set 0 to skip unused GPIO outputs.
# Available means its interface initialized, not proof of physical motor/pump attachment.
PI_MOTORS_ENABLED=1
PI_SERVOS_ENABLED=1
PI_PUMP_ENABLED=1
PI_CAMERA_ENABLED=1
