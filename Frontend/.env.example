# Copy to Frontend/.env. Keep both tokens private and different.
# Generate a token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROBO_UI_TOKEN=
# Must match the backend ROBO_SERVICE_TOKEN.
ROBO_SERVICE_TOKEN=
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
ROBO_BACKEND_URL=http://127.0.0.1:8100
# Optional additional exact browser origins, comma separated (no trailing slash).
# Binding a LAN interface requires explicitly adding that browser origin here.
FRONTEND_ORIGINS=
