# Copy to ML/.env. This service runs on your COMPUTER, not the Raspberry Pi.
ML_HOST=127.0.0.1
ML_PORT=8200
# Generate a local secret; backend sends Authorization: Bearer <this value>.
ML_SERVICE_TOKEN=
ML_STREAM_URL=rtsp://robo.local:8554/cam
ML_STREAM_ID=pi-cam
ML_MODEL_REGISTRY=models/registry.json
ML_DEVICE=cpu
ML_CONFIDENCE=0.35
ML_MAX_FPS=10
ML_BACKEND_TIMEOUT_SECONDS=10
ROBOT_NAME=Robo
# OpenAI-compatible /v1 base URL, without /chat/completions.
CHAT_BASE_URL=https://api.openai.com/v1
# Fill in a Chat Completions model supported by your provider/account.
CHAT_MODEL=
CHAT_API_KEY=
CHAT_TIMEOUT_SECONDS=20
# Some providers/models require max_completion_tokens instead of max_tokens.
CHAT_TOKEN_LIMIT_FIELD=max_tokens
# Offline alternative after separately installing a compatible local model:
# CHAT_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_MODEL=<your-local-model-name>
# CHAT_API_KEY=ollama
